# Required for auth (email + OAuth), database, and API routes.
# Copy this file to .env.local in the same folder (web/) and fill values — never commit .env.local.
#
# Get URL + anon key:
#   1) cd into this web folder and run: npx @insforge/cli link   (once per machine)
#   2) npx @insforge/cli metadata --json
# Or copy from the InsForge dashboard → your project → API / keys.
#
# After editing .env.local, restart: npm run dev
#
# --- Vercel (production) ---
# In Vercel → Project → Settings:
#   - Root Directory: leave empty (.) — for github.com/charangch/the9thedition the Next.js app is at the repo root.
#     Use `web` only if your Git layout is a monorepo with the app in a `web/` subfolder.
#   - Production Branch: prod (or main, match your Git workflow)
#   - Environment Variables: paste all production values below
#   - Domains: theninthedition.com + www (pick one canonical; set 301 on the other)
#   - InsForge dashboard: add Site URL redirect URLs for production, e.g.
#       https://www.theninthedition.com/login
#       https://www.theninthedition.com/reset-password
#       https://www.theninthedition.com/auth/callback
#   - Google Search Console / Bing Webmaster: verify domain, submit https://www.theninthedition.com/sitemap.xml
#   - Optional: Log Drains (Axiom, Datadog, Better Stack) in Vercel for retention + alerts
#   - Cron: CRON_SECRET is required for /api/cron/indexnow (set in Vercel env; Vercel sends Bearer token)

NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# Canonical site URL (no trailing slash). Must match your live domain.
NEXT_PUBLIC_SITE_URL=https://www.theninthedition.com

# Server-only: same origin as NEXT_PUBLIC_SITE_URL; used for auth redirects (no Host-header trust in production).
APP_ORIGIN=https://www.theninthedition.com

# Optional: comma-separated extra origins (e.g. Vercel preview URLs) allowed for CORS on /api/*
# ALLOWED_ORIGINS=https://my-preview.vercel.app

# Auth email links should include these in allowed redirect URLs (InsForge):
# http://localhost:3000/login
# http://localhost:3000/reset-password

# Optional: privileged server operations (never expose to browser)
INSFORGE_SERVICE_KEY=
ADMIN_BOOTSTRAP_USER_ID=
ADMIN_BOOTSTRAP_DISPLAY_NAME=

# --- Sample admin login (format only; you create the real user in InsForge) ---
# /login only accepts emails ending in @theninthedition.com (see src/lib/admin-auth.ts).
# Example email: admin@theninthedition.com
# Example password: choose any strong password (8+ chars) when creating the user.
# Grant admin in DB: set ADMIN_BOOTSTRAP_USER_ID to that user's UUID from InsForge, then:
#   npm run bootstrap:admin
# Or create additional admins from /admin while signed in (Admin → Users).
#
# Dev-only: test InsForge sign-up + verification email (NODE_ENV must be "development"):
#   ALLOW_DEV_SIGNUP=true
# Then POST /api/auth/signup JSON { "email": "you@theninthedition.com", "password": "YourPass123!" }
# Inspect JSON: requireEmailVerification / hasSession. Confirm email in InsForge logs or inbox.
#
# One-command sample admin (creates user + admin profile; prints password to terminal):
#   cd web && npm run create-sample-admin
# Defaults: sample.admin@theninthedition.com / SampleAdmin9th!
# Override: SAMPLE_ADMIN_EMAIL=… SAMPLE_ADMIN_PASSWORD=… npm run create-sample-admin

# Storage bucket for user-uploaded profile photos (create in InsForge; default name below)
INSFORGE_AVATAR_BUCKET=avatars
INSFORGE_SUBMISSIONS_BUCKET=submission-media

# Optional Directus CMS integration for public/editorial collections
DIRECTUS_URL=
DIRECTUS_PUBLIC_TOKEN=
DIRECTUS_STATIC_TOKEN=

# Optional: Upstash Redis for distributed rate limits (recommended on Vercel serverless)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Sentry (error tracking). Set NEXT_PUBLIC_SENTRY_DSN in Vercel; optional org/project for source maps CI:
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05

# IndexNow (Bing/Yandex and partners). Generate a random key string; host exposes https://YOUR_DOMAIN/{KEY}.txt
INDEXNOW_KEY=
# Secret for POST /api/indexnow (Bearer INDEXNOW_WEBHOOK_SECRET) from CI or admin scripts
INDEXNOW_WEBHOOK_SECRET=

# Vercel Cron: Authorization: Bearer CRON_SECRET on GET /api/cron/indexnow
CRON_SECRET=

# Playwright E2E (optional; never commit real passwords)
# PLAYWRIGHT_ADMIN_EMAIL=admin@theninthedition.com
# PLAYWRIGHT_ADMIN_PASSWORD=

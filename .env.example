# Required for auth (email + OAuth), database, and API routes.
# Copy this file to .env.local in the same folder (web/) and fill values — never commit .env.local.
#
# Get URL + anon key:
#   1) cd into this web folder and run: npx @insforge/cli link   (once per machine)
#   2) npx @insforge/cli metadata --json
# Or copy from the InsForge dashboard → your project → API / keys.
#
# After editing .env.local, restart: npm run dev
NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# Auth email links should include these in allowed redirect URLs:
# http://localhost:3000/login
# http://localhost:3000/reset-password

# Optional: privileged server operations (never expose to browser)
INSFORGE_SERVICE_KEY=
ADMIN_BOOTSTRAP_USER_ID=
ADMIN_BOOTSTRAP_DISPLAY_NAME=

# --- Sample admin login (format only; you create the real user in InsForge) ---
# /login only accepts emails ending in @theninthedition.com (see src/lib/admin-auth.ts).
# Example email: admin@theninthedition.com
# Example password: choose any strong password (8+ chars) when creating the user.
# Grant admin in DB: set ADMIN_BOOTSTRAP_USER_ID to that user's UUID from InsForge, then:
#   npm run bootstrap:admin
# Or create additional admins from /admin while signed in (Admin → Users).
#
# Dev-only: test InsForge sign-up + verification email (NODE_ENV must be "development"):
#   ALLOW_DEV_SIGNUP=true
# Then POST /api/auth/signup JSON { "email": "you@theninthedition.com", "password": "YourPass123!" }
# Inspect JSON: requireEmailVerification / hasSession. Confirm email in InsForge logs or inbox.
#
# One-command sample admin (creates user + admin profile; prints password to terminal):
#   cd web && npm run create-sample-admin
# Defaults: sample.admin@theninthedition.com / SampleAdmin9th!
# Override: SAMPLE_ADMIN_EMAIL=… SAMPLE_ADMIN_PASSWORD=… npm run create-sample-admin

# Storage bucket for user-uploaded profile photos (create in InsForge; default name below)
INSFORGE_AVATAR_BUCKET=avatars
INSFORGE_SUBMISSIONS_BUCKET=submission-media

# Optional Directus CMS integration for public/editorial collections
DIRECTUS_URL=
DIRECTUS_PUBLIC_TOKEN=
DIRECTUS_STATIC_TOKEN=
